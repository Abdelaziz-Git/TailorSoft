using System;
using System.Collections.Generic;
using System.Drawing;
using System.IO;
using System.Linq;
using System.Security.Cryptography;
using System.Text;
using System.Threading.Tasks;

namespace TailorSoft.Global_Classes
{
    public static class clsImageHelper
    {
        // Image cache for performance
        private static readonly Dictionary<string, Image> _imageCache = new();

        // Checks whether the byte array appears to be an image.
        public static bool IsLikelyImage(byte[]? imageData)
        {
            if (imageData == null || imageData.Length < 8)
                return false;

            // PNG header is: 89 50 4E 47 0D 0A 1A 0A
            if (imageData[0] == 0x89 &&
                imageData[1] == 0x50 &&
                imageData[2] == 0x4E &&
                imageData[3] == 0x47 &&
                imageData[4] == 0x0D &&
                imageData[5] == 0x0A &&
                imageData[6] == 0x1A &&
                imageData[7] == 0x0A)
            {
                return true;
            }

            // JPEG header can start with: FF D8 and end with FF D9
            if (imageData[0] == 0xFF && imageData[1] == 0xD8)
                return true;

            // BITMAP header "BM"
            if (imageData[0] == 0x42 && imageData[1] == 0x4D)
                return true;

            // Additional checks for GIF etc. can be added here.

            return false;
        }

        private static string GetImageKey(byte[] imageData)
        {
            using var sha = SHA256.Create();
            var hash = sha.ComputeHash(imageData);
            return Convert.ToBase64String(hash);
        }

        public static Image LoadImage(byte[]? imageData, Image defaultImage)
        {
            if (!IsLikelyImage(imageData))
                return defaultImage;

            var key = GetImageKey(imageData!);
            if (_imageCache.TryGetValue(key, out var cachedImage))
            {
                return (Image)cachedImage.Clone();
            }

            try
            {
                using var ms = new MemoryStream(imageData, writable: false);
                var img = Image.FromStream(ms, useEmbeddedColorManagement: false, validateImageData: false);
                var clone = (Image)img.Clone();
                _imageCache[key] = clone;
                return (Image)clone.Clone();
            }
            catch (ArgumentException)
            {
                return defaultImage;
            }
            catch (OutOfMemoryException)
            {
                return defaultImage;
            }
        }
    }
}
